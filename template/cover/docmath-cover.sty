%% ===================================================================
%%  docmath-cover.sty -- Doc Math DZ cover generator and metadata keys
%%
%%  Metadata (set once in book.tex):
%%    \dmzset{
%%      title    = Linear Algebra,
%%      subtitle = Theory, Intuition and Doctoral Problems,
%%      subject  = Linear Algebra,
%%      tagline  = Theory * Intuition * Proofs * Examples * PhD Problems,
%%      author   = Abdelouahab Mostafa,
%%      volume   = 1,
%%      accent   = dmzblue,
%%      edition  = First Edition,
%%      year     = 2026,
%%    }
%%
%%  \dmzmakecover draws the front cover; \dmzlogo prints the series mark.
%%  Original identity of the series: ivory paper, one accent band per
%%  subject, discreet mathematical grid. Nothing is copied from any publisher.
%% ===================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{docmath-cover}[2026/08/04 v1.0 Doc Math DZ cover]
\RequirePackage{tikz}
\RequirePackage{docmath-colors}

%% ------------------------------------------------------------------
%% Metadata keys
%% ------------------------------------------------------------------
\pgfkeys{/dmz/.cd,
  title/.store in=\dmz@title,
  subtitle/.store in=\dmz@subtitle,
  subject/.store in=\dmz@subject,
  tagline/.store in=\dmz@tagline,
  author/.store in=\dmz@author,
  volume/.store in=\dmz@volume,
  series/.store in=\dmz@series,
  edition/.store in=\dmz@edition,
  year/.store in=\dmz@year,
  accent/.code={\def\dmz@accent{#1}\colorlet{dmzaccent}{#1}},
}
\newcommand{\dmzset}[1]{\pgfkeys{/dmz/.cd,#1}}

% defaults
\dmzset{title={Untitled Volume},subtitle={},subject={Mathematics},tagline={},
        author={Abdelouahab Mostafa},volume={1},
        series={Doc Math DZ Book Series},edition={First Edition},
        year={\the\year},accent=dmzblue}

%% ------------------------------------------------------------------
%% Series mark: a sober monogram, no illustration
%% ------------------------------------------------------------------
\newcommand{\dmzlogo}[1][1]{%
  \begin{tikzpicture}[scale=#1,line width=0.6pt,baseline=0pt]
    \draw[dmzink,rounded corners=1.5pt] (0,0) rectangle (0.86,0.86);
    \node[text=dmzink,font=\sffamily\bfseries\tiny] at (0.43,0.47) {DM};
    \draw[dmzaccent,line width=1.2pt] (0.18,0.16) -- (0.68,0.16);
  \end{tikzpicture}}

%% ------------------------------------------------------------------
%% Front cover
%% ------------------------------------------------------------------
\newcommand{\dmzmakecover}{%
  \begingroup
  \newgeometry{margin=0mm}%
  \thispagestyle{empty}%
  \begin{tikzpicture}[remember picture,overlay]
    %% ivory paper
    \fill[dmzpaper] (current page.south west) rectangle (current page.north east);
    %% discreet mathematical grid in the upper third
    \begin{scope}
      \clip ([xshift=16mm,yshift=-96mm]current page.north west)
            rectangle (current page.north east);
      \draw[dmzaccent!14,line width=0.25pt,step=7mm]
            ([xshift=16mm,yshift=-96mm]current page.north west)
            grid (current page.north east);
      \draw[dmzaccent!30,line width=0.5pt]
            ([xshift=30mm,yshift=-30mm]current page.north east) circle (16mm);
      \draw[dmzaccent!22,line width=0.5pt]
            ([xshift=52mm,yshift=-46mm]current page.north east) circle (26mm);
    \end{scope}
    %% vertical accent band (subject identity)
    \fill[dmzaccent] (current page.north west)
          rectangle ([xshift=13mm]current page.south west);
    \fill[dmzaccent!45] ([xshift=13mm]current page.north west)
          rectangle ([xshift=16mm]current page.south west);
    %% series branding
    \node[anchor=north west,inner sep=0pt,align=left]
      at ([xshift=28mm,yshift=-30mm]current page.north west)
      {\sffamily\bfseries\fontsize{11}{13}\selectfont\color{dmzaccent}%
       \MakeUppercase{\dmz@series}};
    %% title block
    \node[anchor=north west,inner sep=0pt,text width=118mm,align=left]
      at ([xshift=28mm,yshift=-72mm]current page.north west)
      {\sffamily\bfseries\fontsize{32}{37}\selectfont\color{dmzink}\dmz@title};
    \node[anchor=north west,inner sep=0pt]
      at ([xshift=28mm,yshift=-118mm]current page.north west)
      {\color{dmzaccent}\rule{42mm}{1.4pt}};
    \node[anchor=north west,inner sep=0pt,text width=118mm,align=left]
      at ([xshift=28mm,yshift=-126mm]current page.north west)
      {\sffamily\fontsize{13}{17}\selectfont\color{dmzsoft}\dmz@subtitle};
    \node[anchor=north west,inner sep=0pt,text width=118mm,align=left]
      at ([xshift=28mm,yshift=-150mm]current page.north west)
      {\sffamily\fontsize{9.5}{14}\selectfont\color{dmzsoft}\dmz@tagline};
    %% author, volume, logo
    \node[anchor=south west,inner sep=0pt]
      at ([xshift=28mm,yshift=52mm]current page.south west)
      {\sffamily\fontsize{14}{16}\selectfont\color{dmzink}\dmz@author};
    \node[anchor=south west,inner sep=0pt]
      at ([xshift=28mm,yshift=42mm]current page.south west)
      {\sffamily\fontsize{10}{12}\selectfont\color{dmzsoft}Volume~\dmz@volume};
    \node[anchor=south west,inner sep=0pt]
      at ([xshift=28mm,yshift=24mm]current page.south west)
      {\dmzlogo[1.1]};
    \node[anchor=south west,inner sep=0pt]
      at ([xshift=40mm,yshift=26mm]current page.south west)
      {\sffamily\bfseries\fontsize{9}{11}\selectfont\color{dmzink}DOC MATH DZ};
    \node[anchor=south east,inner sep=0pt]
      at ([xshift=-18mm,yshift=24mm]current page.south east)
      {\sffamily\fontsize{9}{11}\selectfont\color{dmzsoft}\dmz@subject};
  \end{tikzpicture}%
  \clearpage
  \restoregeometry
  \endgroup}

\endinput
