%% ===================================================================
%%  docmath-typography.sty -- headings, headers, table of contents
%%
%%  All display typography of the series lives here: chapter opening
%%  pages, section headings, running heads, TOC design, list design.
%% ===================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{docmath-typography}[2026/08/04 v1.0 Doc Math DZ typography]
\RequirePackage{docmath-colors}
\RequirePackage{titlesec}
\RequirePackage{titletoc}
\RequirePackage{fancyhdr}

%% --- paragraphs ---------------------------------------------------
\setlength{\parindent}{1.2em}
\setlength{\parskip}{0pt plus 1pt}
\setlength{\emergencystretch}{2em}
\clubpenalty=10000
\widowpenalty=10000

%% --- chapter opening page ----------------------------------------
\titleformat{\chapter}[display]
  {\normalfont\sffamily}
  {\raggedleft{\footnotesize\bfseries\color{dmzaccent}%
     \MakeUppercase{\chaptertitlename}}\\[-2pt]%
   {\fontsize{58}{58}\selectfont\bfseries\color{dmzaccent!85!dmzink}\thechapter}}
  {8pt}
  {\raggedleft\fontsize{24}{28}\selectfont\bfseries\color{dmzink}}
  [\vspace{5pt}{\color{dmzaccent}\titlerule[1.1pt]}\vspace{2pt}%
   {\color{dmzrule}\titlerule[0.4pt]}]
\titlespacing*{\chapter}{0pt}{10pt}{34pt}

\titleformat{name=\chapter,numberless}[display]
  {\normalfont\sffamily}
  {}
  {0pt}
  {\raggedleft\fontsize{24}{28}\selectfont\bfseries\color{dmzink}}
  [\vspace{5pt}{\color{dmzaccent}\titlerule[1.1pt]}]
\titlespacing*{name=\chapter,numberless}{0pt}{10pt}{30pt}

%% --- sections -----------------------------------------------------
\titleformat{\section}
  {\normalfont\sffamily\Large\bfseries\color{dmzink}}
  {\color{dmzaccent}\thesection}{0.7em}{}
\titleformat{\subsection}
  {\normalfont\sffamily\large\bfseries\color{dmzink}}
  {\color{dmzaccent}\thesubsection}{0.6em}{}
\titleformat{\subsubsection}
  {\normalfont\sffamily\normalsize\bfseries\color{dmzink}}
  {\color{dmzaccent}\thesubsubsection}{0.6em}{}
\titlespacing*{\section}{0pt}{16pt plus 3pt}{7pt}
\titlespacing*{\subsection}{0pt}{12pt plus 2pt}{5pt}

%% --- running heads ------------------------------------------------
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{dmzrule}\leaders\hrule height \headrulewidth\hfill}}
\fancyhead[LE]{\sffamily\small\color{dmzsoft}\thepage\quad\textbar\quad\nouppercase{\leftmark}}
\fancyhead[RO]{\sffamily\small\color{dmzsoft}\nouppercase{\rightmark}\quad\textbar\quad\thepage}
\fancypagestyle{plain}{%
  \fancyhf{}\renewcommand{\headrulewidth}{0pt}%
  \fancyfoot[C]{\sffamily\small\color{dmzsoft}\thepage}}
\renewcommand{\chaptermark}[1]{\markboth{\chaptername\ \thechapter.\ #1}{}}
\renewcommand{\sectionmark}[1]{\markright{\thesection\quad #1}}

%% --- table of contents -------------------------------------------
\titlecontents{chapter}[0em]
  {\addvspace{11pt}\sffamily\bfseries\color{dmzink}}
  {\color{dmzaccent}\thecontentslabel\quad}
  {}
  {\hfill\contentspage}
\titlecontents{section}[1.9em]
  {\addvspace{2pt}\sffamily\small}
  {\color{dmzaccent}\thecontentslabel\quad}
  {}
  {\titlerule*[0.7pc]{\color{dmzrule}.}\contentspage}

%% --- lists --------------------------------------------------------
\setlist{itemsep=2pt,parsep=2pt,topsep=4pt,leftmargin=*}
\setlist[itemize,1]{label=\textcolor{dmzaccent}{\textbullet}}
\setlist[itemize,2]{label=\textcolor{dmzaccent}{\textendash}}
\setlist[enumerate,1]{label=\textcolor{dmzaccent}{(\arabic*)}}

%% --- captions -----------------------------------------------------
\captionsetup{font=small,labelfont={bf,sf},labelsep=period,
              justification=centering,skip=6pt}

%% --- part pages ---------------------------------------------------
\titleformat{\part}[display]
  {\normalfont\sffamily\centering}
  {\large\bfseries\color{dmzaccent}\MakeUppercase{\partname}\ \thepart}
  {12pt}
  {\fontsize{30}{34}\selectfont\bfseries\color{dmzink}}

\endinput
