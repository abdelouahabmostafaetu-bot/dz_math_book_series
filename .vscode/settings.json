{
  "//": "Doc Math DZ Book Series -- shared VS Code / LaTeX Workshop setup.",
  "//1": "TEXINPUTS is NOT set here on purpose: the separator differs between",
  "//2": "Windows (;) and Unix (:), and VS Code settings cannot branch on the",
  "//3": "platform. Each volume's .latexmkrc detects it and sets the variable,",
  "//4": "so the only requirement is that latexmk runs in the file's directory,",
  "//5": "which LaTeX Workshop already does.",

  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "latexmk",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-pdf",
        "%DOC%"
      ]
    }
  ],

  "latex-workshop.latex.recipes": [
    {
      "name": "Build (latexmk)",
      "tools": ["latexmk"]
    }
  ],

  "latex-workshop.latex.recipe.default": "first",
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.rootFile.doNotPrompt": true,
  "latex-workshop.latex.rootFile.useSubFile": false,
  "latex-workshop.latex.autoClean.run": "never",
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.synctex.afterBuild.enabled": true,
  "latex-workshop.message.log.show": false,
  "latex-workshop.latex.watch.files.ignore": [
    "**/*.bbl",
    "**/*.aux",
    "**/*.idx",
    "**/*.ind"
  ],

  "[latex]": {
    "editor.wordWrap": "on",
    "editor.wrappingIndent": "same",
    "editor.rulers": [88],
    "editor.tabSize": 2,
    "editor.formatOnSave": false,
    "files.trimTrailingWhitespace": true
  },

  "[bibtex]": {
    "editor.tabSize": 2
  },

  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.insertFinalNewline": true,

  "search.exclude": {
    "**/*.aux": true,
    "**/*.bbl": true,
    "**/*.bcf": true,
    "**/*.blg": true,
    "**/*.fdb_latexmk": true,
    "**/*.fls": true,
    "**/*.idx": true,
    "**/*.ilg": true,
    "**/*.ind": true,
    "**/*.log": true,
    "**/*.out": true,
    "**/*.run.xml": true,
    "**/*.synctex.gz": true,
    "**/*.toc": true
  }
}
